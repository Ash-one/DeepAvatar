# ==============================================================================
# Deep Persona — Environment Configuration Sample
# Copy this file to .env and configure your credentials:
#   cp .env.example .env
# ==============================================================================

# API key for Gemini / OpenAI-compatible LLM gateway
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Gateway Endpoint
# Local proxy example:  http://127.0.0.1:8045
# Remote/Cloud example: https://api.openai.com/v1 or custom OpenAI-compatible gateway
GEMINI_ENDPOINT=http://127.0.0.1:8045

# Optional default model override (defaults to gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash
